# Moderate diagnostics; no cpu_test stress or large speed downloads.
/redwood/bin/cputop 10 &
/redwood/bin/gl_test 0 320 240 &
/redwood/bin/net_test wifi waitaddr en0 60 store resolve example.com tcp example.com 80 reach example.com fetch https://www.apple.com/library/test/success.html &
/redwood/bin/rwtouch wait 100 swipe 0.5 0.985 0.5 0.3 200 wait 8
/redwood/bin/rwtouch swipe 0.85 0.5 0.15 0.5 300 wait 2 swipe 0.15 0.5 0.85 0.5 300 wait 2
/redwood/bin/fps_info
