+/* The driver first blocks sends and cancels its bounded waits. Keep requests and
+ * the user's power selection while draining callbacks before shared memory is reset. */
+void
+hakios_sta_recovery_begin(void)
+{
+	lck_mtx_lock(&sta_lock);
+	sta_recovering = true;
+	while (sta_calls || sta_reads != 0) {
+		lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+	}
+	heard_count = 0;
+	lck_mtx_unlock(&sta_lock);
+}
+
+void
+hakios_sta_recovery_end(void)
+{
+	lck_mtx_lock(&sta_lock);
+	/* Power-off and leave take precedence over rejoining. A newer explicit join wins. */
+	if (sta_on && !asked_join && !asked_leave && reconnect.ssid_length != 0) {
+		asked_join_what = reconnect;
+		asked_join = true;
+	}
+	sta_recovering = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+}
