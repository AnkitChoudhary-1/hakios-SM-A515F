+static int
+set_scan_multiple(const struct apple80211req *request, char *said, size_t said_size)
+{
+	if (request->req_len == sizeof(struct apple80211_scan_request)) {
+		return set_scan(request, said, said_size);
+	}
+	if (!hakios_sta_present()) {
+		return EBUSY;
+	}
+	struct hakios_sta_scan *what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	uint8_t *buf = NULL;
+	int error = 0;
+	if (what == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_data != USER_ADDR_NULL && request->req_len >= 12) {
+		size_t take = request->req_len < 64 ? request->req_len : 64;
+		buf = kalloc_data(take, Z_WAITOK | Z_ZERO);
+		if (buf == NULL) {
+			kfree_data(what, sizeof(*what));
+			return ENOMEM;
+		}
+		if ((error = copyin(request->req_data, buf, take)) != 0) {
+			kfree_data(buf, take);
+			kfree_data(what, sizeof(*what));
+			return error;
+		}
+		uint32_t ssid_count = (uint32_t)(buf[8] | buf[9] << 8 | buf[10] << 16 | buf[11] << 24);
+		if (ssid_count >= 1 && ssid_count <= 10 && take >= 48) {
+			uint32_t slen = (uint32_t)(buf[12] | buf[13] << 8 | buf[14] << 16 | buf[15] << 24);
+			if (slen > 0 && slen <= 32 && 16u + slen <= take) {
+				what->ssid_length = (uint8_t)slen;
+				memcpy(what->ssid, buf + 16, slen);
+			}
+		}
+		kfree_data(buf, take);
+	}
+	what->passive = false;
+	snprintf(said, said_size, " (multi-scan %u bytes, ssid_len=%u)", request->req_len, what->ssid_length);
+	lck_mtx_lock(&apple80211_lock);
+	result_next = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = hakios_sta_ask_scan(what);
+	kfree_data(what, sizeof(*what));
+	return error;
+}
