+static bool a51DsimEnsureClock(void)
+{
+    if (gDsimClockReady) return true;
+    vm_offset_t pmu = ml_io_map(0x11860000UL, 0x5000);
+    if (!pmu) return false;
+    if ((*(volatile uint32_t *)(pmu + 0x4004u) & 0xfu) != 0xfu) {
+        return false; /* DISPAUD power domain off (e.g. QEMU) */
+    }
+    vm_offset_t cmu = ml_io_map(0x14980000UL, 0x4000);
+    if (!cmu) return false;
+    static const uint16_t dispGates[] = {
+        0x200c, 0x2044, 0x2050, 0x2054, 0x2060, 0x2064, 0x2068,
+        0x2070, 0x2074, 0x208c, 0x2090, 0x20a8, 0x20ac, 0x20b4
+    };
+    static const uint16_t dispQchs[] = {
+        0x302c, 0x3030, 0x3034, 0x3038, 0x303c, 0x3044, 0x3048, 0x3054, 0x3064
+    };
+    for (unsigned i = 0; i < sizeof(dispGates) / sizeof(dispGates[0]); i++) {
+        volatile uint32_t *reg = (volatile uint32_t *)(cmu + dispGates[i]);
+        *reg = (*reg & ~(1u << 28)) | (3u << 20);
+    }
+    for (unsigned i = 0; i < sizeof(dispQchs) / sizeof(dispQchs[0]); i++) {
+        volatile uint32_t *reg = (volatile uint32_t *)(cmu + dispQchs[i]);
+        *reg = (*reg & ~7u) | 6u;
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    gDsimClockReady = true;
+    return true;
+}
+
+static inline uint32_t dsimRead(uint32_t off)
+{
+    return *(volatile uint32_t *)(gDsimBase + off);
+}
+
+static inline void dsimWrite(uint32_t off, uint32_t val)
+{
+    *(volatile uint32_t *)(gDsimBase + off) = val;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int a51DsimWaitTxWritable(void)
+{
+    for (int i = 0; i < 2000; i++) {
+        uint32_t f = dsimRead(A51_DSIM_FIFOCTRL);
+        if (!(f & A51_DSIM_FIFO_FULL_PH) && !(f & A51_DSIM_FIFO_FULL_PL)) return 0;
+        IODelay(5);
+    }
+    return -1;
+}
+
+static int a51DsimSendDCS(uint8_t cmd, const uint8_t *payload, uint32_t len)
+{
+    if (!gDsimBase || len > 32) return -1;
+    if (dsimRead(A51_DSIM_INTSRC) & A51_DSIM_INTSRC_ERROR_MASK) {
+        dsimWrite(A51_DSIM_INTSRC, A51_DSIM_INTSRC_ERROR_MASK);
+    }
+    if (a51DsimWaitTxWritable() != 0) {
+        dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_PH | A51_DSIM_FIFOCTRL_INIT_PL);
+        dsimWrite(A51_DSIM_INTSRC, A51_DSIM_INTSRC_ERROR_MASK);
+        return -1;
+    }
+    if (len == 0) {
+        dsimWrite(A51_DSIM_PKTHDR, 0x05u | ((uint32_t)cmd << 8));
+    } else if (len == 1) {
+        dsimWrite(A51_DSIM_PKTHDR, 0x15u | ((uint32_t)cmd << 8) | ((uint32_t)payload[0] << 16));
+    } else {
+        uint32_t word = (uint32_t)cmd;
+        uint32_t shift = 8;
+        for (uint32_t i = 0; i < len; i++) {
+            word |= ((uint32_t)payload[i] << shift);
+            shift += 8;
+            if (shift == 32 || i == len - 1) {
+                dsimWrite(A51_DSIM_PAYLOAD, word);
+                word = 0;
+                shift = 0;
+            }
+        }
+        dsimWrite(A51_DSIM_PKTHDR, 0x39u | ((len + 1u) << 8));
+    }
+    for (int i = 0; i < 2000; i++) {
+        uint32_t intsrc = dsimRead(A51_DSIM_INTSRC);
+        if (intsrc & A51_DSIM_INTSRC_ERROR_MASK) {
+            dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_PH | A51_DSIM_FIFOCTRL_INIT_PL);
+            dsimWrite(A51_DSIM_INTSRC, A51_DSIM_INTSRC_ERROR_MASK);
+            return -1;
+        }
+        uint32_t f = dsimRead(A51_DSIM_FIFOCTRL);
+        if ((f & A51_DSIM_FIFO_EMPTY_PH) && (len < 2 || (f & A51_DSIM_FIFO_EMPTY_PL))) {
+            return 0;
+        }
+        IODelay(5);
+    }
+    dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_PH | A51_DSIM_FIFOCTRL_INIT_PL);
+    return -1;
+}
+
+static int a51DsimReadDCS(uint8_t cmd, uint8_t *rx, uint32_t rxLen, uint32_t *outLen)
+{
+    if (outLen) *outLen = 0;
+    if (!gDsimBase || !rx || !rxLen || rxLen > 16) return -1;
+    dsimWrite(A51_DSIM_INTSRC, A51_DSIM_INTSRC_RX_DATA_DONE | A51_DSIM_INTSRC_ERROR_MASK);
+    dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_RX);
+    if (a51DsimWaitTxWritable() != 0) return -1;
+    dsimWrite(A51_DSIM_PKTHDR, 0x37u | (rxLen << 8));
+    dsimWrite(A51_DSIM_PKTHDR, A51_DSIM_PKTHDR_BTA | 0x06u | ((uint32_t)cmd << 8));
+    int ok = 0;
+    for (int i = 0; i < 2000; i++) {
+        uint32_t intsrc = dsimRead(A51_DSIM_INTSRC);
+        /* Check hardware error bits before RX_DATA_DONE */
+        if (intsrc & A51_DSIM_INTSRC_ERROR_MASK) {
+            dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_PH | A51_DSIM_FIFOCTRL_INIT_PL | A51_DSIM_FIFOCTRL_INIT_RX);
+            dsimWrite(A51_DSIM_INTSRC, A51_DSIM_INTSRC_ERROR_MASK | A51_DSIM_INTSRC_RX_DATA_DONE);
+            return -1;
+        }
+        if (intsrc & A51_DSIM_INTSRC_RX_DATA_DONE) {
+            ok = 1;
+            break;
+        }
+        IODelay(5);
+    }
+    if (!ok || (dsimRead(A51_DSIM_FIFOCTRL) & A51_DSIM_FIFOCTRL_EMPTY_RX)) {
+        dsimWrite(A51_DSIM_FIFOCTRL, A51_DSIM_FIFOCTRL_INIT_RX);
+        return -1;
+    }
+    uint32_t hdr = dsimRead(A51_DSIM_RXFIFO);
+    uint32_t dt = hdr & 0xFFu;
+    if (dt == 0x21u || dt == 0x11u) {
+        rx[0] = (uint8_t)((hdr >> 8) & 0xFFu);
+        if (outLen) *outLen = 1;
+        return 0;
+    } else if (dt == 0x22u || dt == 0x12u) {
+        rx[0] = (uint8_t)((hdr >> 8) & 0xFFu);
+        if (rxLen > 1) rx[1] = (uint8_t)((hdr >> 16) & 0xFFu);
+        if (outLen) *outLen = 2;
+        return 0;
+    } else if (dt == 0x1Cu || dt == 0x1Au) {
+        uint32_t wc = (hdr >> 8) & 0xFFFFu;
+        uint32_t n = wc < rxLen ? wc : rxLen;
+        uint32_t words = (n + 3u) / 4u, copied = 0;
+        for (uint32_t w = 0; w < words; w++) {
+            if (dsimRead(A51_DSIM_FIFOCTRL) & A51_DSIM_FIFOCTRL_EMPTY_RX) return -1;
+            uint32_t wd = dsimRead(A51_DSIM_RXFIFO);
+            for (uint32_t b = 0; b < 4 && copied < n; b++) rx[copied++] = (uint8_t)((wd >> (b * 8)) & 0xFFu);
+        }
+        if (outLen) *outLen = wc;
+        return 0;
+    }
+    return -1;
+}
