+/* Hardware Exynos DSIM AMOLED Brightness Control via kern.hakios.brightness */
+static void update_oled_dimmer(double b)
+{
+	if (b < 0.0) b = 0.0;
+	if (b > 1.0) b = 1.0;
+	int level = (int)(b * 255.0 + 0.5);
