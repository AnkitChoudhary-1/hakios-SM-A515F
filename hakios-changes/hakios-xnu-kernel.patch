+            if (num != NULL) {
+                uint64_t v = num->unsigned64BitValue();
+                int level;
+                if (v <= 255ULL) level = (int)v;
+                else if (v <= 1000ULL) level = (int)((v * 255ULL + 500ULL) / 1000ULL);
