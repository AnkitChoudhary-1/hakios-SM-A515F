+static void a51DsimProbeInit(void)
+{
+    if (!gDsimLock) gDsimLock = IOLockAlloc();
+    IOLockLock(gDsimLock);
+    if (a51DsimEnsureClock()) {
+        if (!gDsimBase) gDsimBase = ml_io_map(A51_DSIM_PA, 0x1000);
+        if (gDsimBase) {
+            uint32_t cfg = dsimRead(A51_DSIM_CONFIG);
+            IOLog("MiniIOMobileFramebuffer: DSIM config=%#x lanes=%#x\n",
+                  cfg, cfg & A51_DSIM_CONFIG_LANES_EN_MASK);
+        }
+    }
+    IOLockUnlock(gDsimLock);
+}
+
+static int a51DsimSetBrightness(int level)
+{
+    if (level < 0) level = 0;
+    if (level > 255) level = 255;
+    if (!gDsimLock) gDsimLock = IOLockAlloc();
+    IOLockLock(gDsimLock);
+    if (!a51DsimEnsureClock()) {
+        gBrightnessLevel = level;
+        IOLockUnlock(gDsimLock);
+        return 0;
+    }
+    if (!gDsimBase) gDsimBase = ml_io_map(A51_DSIM_PA, 0x1000);
+    if (!gDsimBase || (dsimRead(A51_DSIM_CONFIG) & A51_DSIM_CONFIG_LANES_EN_MASK) == 0) {
+        gBrightnessLevel = level;
+        IOLockUnlock(gDsimLock);
+        return 0;
+    }
+    static const uint8_t keyUnlock[2] = {0x5Au, 0x5Au};
+    static const uint8_t keyLock[2] = {0xA5u, 0xA5u};
+    static const uint8_t ctrlDisp[1] = {0x28u};
+    uint16_t raw = a51_panel_gamma_table[level];
+    uint8_t payload[2] = { (uint8_t)((raw >> 8) & 0x03u), (uint8_t)(raw & 0xFFu) };
+
+    (void)a51DsimSendDCS(0xF0u, keyUnlock, 2);
+    if (!gDsimCtrlInit) {
+        if (a51DsimSendDCS(0x53u, ctrlDisp, 1) == 0) gDsimCtrlInit = true;
+    }
+    int rc = a51DsimSendDCS(0x51u, payload, 2);
+    (void)a51DsimSendDCS(0xF0u, keyLock, 2);
+    if (rc == 0) {
+        gBrightnessLevel = level;
+    }
+    IOLockUnlock(gDsimLock);
+    return rc;
+}
+
+static int a51_brightness_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+    int val = gBrightnessLevel;
+    int error = sysctl_handle_int(oidp, &val, 0, req);
+    if (error || !req->newptr) return error;
+    if (val < 0) val = 0;
+    if (val > 255) val = 255;
+    (void)a51DsimSetBrightness(val);
+    return 0;
+}
