+    if (idx) {
+        size_t left = 64 - idx;
+        if (len < left) {
+            for (size_t k = 0; k < len; k++) { ctx->buffer[idx + k] = data[k]; }
+            return;
+        }
+        for (size_t k = 0; k < left; k++) { ctx->buffer[idx + k] = data[k]; }
+        a51_sha256_transform(ctx->state, ctx->buffer);
+        i = left;
+    }
+    for (; i + 64 <= len; i += 64) {
+        a51_sha256_transform(ctx->state, &data[i]);
