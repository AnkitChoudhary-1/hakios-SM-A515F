+static long
+now(long *us)
+{
+	struct timeval tv = {0, 0, 0};
+	long result = call(SYS_gettimeofday, (long)&tv, 0, 0, 0, 0, 0);
+	if (result) { return result; }
+	if (tv.sec < 0 || tv.sec > 9000000000000L || tv.usec < 0 || tv.usec >= 1000000) { return -1; }
+	*us = tv.sec * 1000000L + tv.usec;
+	return 0;
