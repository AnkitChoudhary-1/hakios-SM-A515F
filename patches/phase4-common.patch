+static long
+wait_seconds(const char *args)
+{
+	const char *key = "hello_wait=";
+	for (unsigned i = 0; args[i]; i++) {
+		unsigned j = 0;
+		if (i && args[i - 1] != ' ') { continue; }
+		while (key[j] && args[i + j] && key[j] == args[i + j]) { j++; }
+		if (!key[j]) {
+			long n = 0;
+			for (i += j; args[i] >= '0' && args[i] <= '9'; i++) {
+				n = n * 10 + args[i] - '0';
+				if (n > 30) { return -1; }
 			}
 			return n;
 		}
 	}
 	return 0;
